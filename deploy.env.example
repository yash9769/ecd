# Template for the Docker deployment's `.env` (read by docker-compose.yml). On the VM,
# GitHub Actions writes this file automatically on the first deploy — see DEPLOYMENT.md.
# Never commit the real .env. (The root `.env.example` is a different thing: Vite's dev vars.)

POSTGRES_USER=envista
POSTGRES_PASSWORD=change-me
POSTGRES_DB=envista

# Port the site is reachable on from outside the VM (must be open in Bharat Cloud's
# firewall AND aaPanel's firewall): 8060 for production, 8055 for staging.
APP_PORT=8060

# Loopback-only port for reaching Postgres via an SSH tunnel (pgAdmin, psql) — never
# exposed to the internet. Different per environment: 15450 production, 15455 staging.
DB_TUNNEL_PORT=15450

# 1 on staging so search engines never index it (serves a Disallow-all robots.txt and an
# X-Robots-Tag header); 0 on production.
NOINDEX=0

# Set to 1 once aaPanel's nginx reverse-proxies a domain to this app (so the contact-form
# rate limit sees real visitor IPs). Leave 0 while people hit the port directly.
TRUST_PROXY=0

# Optional: email a notification for each contact-form submission (https://resend.com).
# Leave blank to disable; submissions are saved to the database regardless.
RESEND_API_KEY=
NOTIFY_EMAIL_TO=
NOTIFY_EMAIL_FROM=

# Which branch deploy.sh pulls from — "production" for production, "staging" for staging.
DEPLOY_BRANCH=production
