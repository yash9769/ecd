# Copy to .env.local for local dev (Vite loads .env.local automatically
# and it's gitignored). Never commit real values.

# Base URL of the Envista API (see server/README.md). No trailing slash.
# Local dev, if the API is running via `npm run dev` in server/:
#   VITE_API_URL=http://localhost:3001
VITE_API_URL=
