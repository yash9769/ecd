# Copy this file to .env and fill in real values. Never commit .env.

# Postgres connection string. Local dev with docker-compose:
#   postgresql://envista:envista@localhost:5432/envista
DATABASE_URL=

# Set to "require" only if your Postgres provider needs TLS and you don't
# already terminate it upstream. Leave blank for a local/private-network DB.
PGSSLMODE=

# Port the API listens on.
PORT=3001

# Comma-separated list of frontend origins allowed to call this API, e.g.
#   https://envistacyberdefence.com,https://www.envistacyberdefence.com
# Include http://localhost:5173 (or your Vite dev port) while developing.
CORS_ORIGIN=

# --- Email notifications (Resend) --------------------------------------
# Get a key at https://resend.com — the free tier is enough for a
# contact-form notification volume. Leave both blank to disable email
# notifications entirely (submissions still save to the database).
RESEND_API_KEY=
# Where submission notifications are sent, e.g. hello@envistacyberdefence.com
NOTIFY_EMAIL_TO=
# Must be a domain verified in your Resend account, or the Resend sandbox
# address (onboarding@resend.dev) while testing.
NOTIFY_EMAIL_FROM=

# Set to "0" only if this API is exposed directly with no reverse proxy
# in front of it (nginx/Caddy/load balancer). Default assumes a proxy.
TRUST_PROXY=
